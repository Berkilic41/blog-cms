@model PostListViewModel
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Home" asp-action="Index"
                   asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId" asp-route-tag="@Model.TagSlug">‹ Prev</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@i" asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId" asp-route-tag="@Model.TagSlug">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="Home" asp-action="Index"
                   asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId" asp-route-tag="@Model.TagSlug">Next ›</a>
            </li>
        </ul>
    </nav>
}
