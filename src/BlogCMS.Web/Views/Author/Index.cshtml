@model PostListViewModel
@{
    ViewData["Title"] = "My Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My Posts</h1>
    <a asp-action="Create" class="btn btn-primary">+ New post</a>
</div>

<div class="bg-white rounded-3 shadow-sm overflow-hidden">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Created</th>
                <th>Stats</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Posts.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No posts yet. <a asp-action="Create">Write your first one →</a></td></tr>
            }
            else
            {
                foreach (var p in Model.Posts)
                {
                    <tr>
                        <td>
                            <a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none">@p.Title</a>
                            <div class="text-muted small">@p.CategoryName</div>
                        </td>
                        <td>
                            @{
                                var badgeClass = p.Status switch {
                                    "Published" => "bg-success-subtle text-success-emphasis",
                                    "Pending"   => "bg-warning-subtle text-warning-emphasis",
                                    "Rejected"  => "bg-danger-subtle text-danger-emphasis",
                                    _           => "bg-secondary-subtle text-secondary-emphasis"
                                };
                            }
                            <span class="badge @badgeClass">@p.Status</span>
                        </td>
                        <td class="text-muted small">@p.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-muted small">💬 @p.CommentCount &middot; ❤ @p.LikeCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this post?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
